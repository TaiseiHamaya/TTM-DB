[Unit]
Description=TicketManager Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ticketbot
WorkingDirectory=/opt/ticket-manager
EnvironmentFile=/etc/ticket-manager/ticket-manager.env
ExecStart=/opt/ticket-manager/ticket-manager
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
